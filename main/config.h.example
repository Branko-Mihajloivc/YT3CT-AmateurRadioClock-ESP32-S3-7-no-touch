/*****************************************************************************
 * config.h.example -- copy this to config.h and fill in your own values.
 * config.h is gitignored (it holds your WiFi password) -- never commit it.
 *****************************************************************************/
#pragma once

// ---- Callsign shown in the top bar ----
#define CALLSIGN "YOUR_CALLSIGN"

// ---- Callsign the boot-screen birthday greeting is signed "- " with ----
// (only relevant if you're building this as a gift for someone else -- set
// it to your own callsign so the greeting is signed by you, not the
// recipient whose callsign is in CALLSIGN above)
#define GIFTER_CALLSIGN "YOUR_CALLSIGN"

// ---- WiFi (needed once at boot to fetch the time over NTP) ----
#define WIFI_SSID     "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// ---- NTP ----
#define NTP_SERVER_1 "pool.ntp.org"
#define NTP_SERVER_2 "time.nist.gov"

// ---- Local time zone, POSIX TZ string ----
// Look up your zone at:
//   https://github.com/nayarsystems/posix_tz_db/blob/master/zones.csv
#define LOCAL_TZ "CET-1CEST,M3.5.0,M10.5.0/3"
